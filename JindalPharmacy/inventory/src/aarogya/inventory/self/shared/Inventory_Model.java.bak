public class Inventory_Model {

    private pmInventory pmMenu = new pmInventory();

    public List<UserMenu> getMenu() {
        List<UserMenu> menuList = new ArrayList<>();
        List<UserMenu> mainMenuList = new ArrayList<>();

        menuList.add(new UserMenu("Masters"));
        mainMenuList = menuList.get(menuList.size() - 1).getUserMenu();
        getGeneral(mainMenuList);

        menuList.add(new UserMenu("Transaction"));
        mainMenuList = menuList.get(menuList.size() - 1).getUserMenu();
        getGeneralTransaction(mainMenuList);
        getBilling(mainMenuList);
        getStores(mainMenuList);
        getStockAudit(mainMenuList);
        getApprovals(mainMenuList);
        getGate(mainMenuList);

        menuList.add(new UserMenu("Reports"));
        mainMenuList = menuList.get(menuList.size() - 1).getUserMenu();
        getDisplay(mainMenuList);
        getReports(mainMenuList);

        menuList.add(new UserMenu("Configs"));
        mainMenuList = menuList.get(menuList.size() - 1).getUserMenu();
        getAdmin(mainMenuList);

        return menuList;
    }

    //<editor-fold defaultstate="collapsed" desc="Gate">
    private void getGate(List<UserMenu> menuList) {
        List<UserMenu> subMenuList;

        menuList.add(new UserMenu("Gate"));
        subMenuList = menuList.get(menuList.size() - 1).getUserMenu();

        subMenuList.add(new UserMenu(pmMenu.GATE_PASS_IN.caption));
        subMenuList.get(subMenuList.size() - 1).getControlPermission().add(GateIn.gateOutByBlog);
        subMenuList.get(subMenuList.size() - 1).getControlPermission().add(GateIn.dateTimeEditableBlog);

        subMenuList.add(new UserMenu(pmMenu.GATE_PASS_OUT.caption));
        subMenuList.get(subMenuList.size() - 1).getControlPermission().add(GateOut.gateOutByBlog);
        subMenuList.get(subMenuList.size() - 1).getControlPermission().add(GateOut.dateTimeEditableBlog);

        subMenuList.add(new UserMenu(pmMenu.VISITOR_GATE_PASS.caption));
        subMenuList.get(subMenuList.size() - 1).getControlPermission().add(VisitorGatePass.dateTimeEditableBlog);
        subMenuList.get(subMenuList.size() - 1).getControlPermission().add(VisitorGatePass.gateOutByBlog);

        subMenuList.add(new UserMenu(pmMenu.GATE_PASS_OUT_REGISTER.caption));
    }
//</editor-fold>

