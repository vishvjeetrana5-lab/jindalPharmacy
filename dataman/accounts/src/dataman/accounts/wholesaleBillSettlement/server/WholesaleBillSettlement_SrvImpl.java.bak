    @Override
    public DmResultPageing<List<TxtHVoucherType_Mdl>> getTxtHVoucherType(DmHelper helper, boolean blnToEndOfFile) {
        DmResultPageing<List<TxtHVoucherType_Mdl>> rstTemp = new DmResultPageing<>();
        List<TxtHVoucherType_Mdl> lstTemp = new ArrayList<>();
        TxtHVoucherType_Mdl listNode;
        Connection cnTemp = null;
        ResultSet rsTemp = null;
        DmPreparedStatement psTemp = null;
        String sqlQuery;

        try {
            rstTemp.setData(lstTemp);
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));
            sqlQuery = "SELECT VT.V_Type,VT.Description,"
                    + "VT.Category"
                    + " FROM Voucher_Type VT "
                    + " WHERE vt.category IN ('" + pvc.WHOLE_SALE_BILL_SETTLEMENT + "')";
            DmSQLWithParam sqlWithParam = new DmSQLWithParam();
            sqlWithParam.setSQL(sqlQuery);
            psTemp = DmServer.evaluateHelper(helper, sqlWithParam, cnTemp, blnToEndOfFile, this);
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                listNode = new TxtHVoucherType_Mdl();
                listNode.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("V_Type")));
                listNode.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("Description")));
                listNode.setCategory(DmShared.xNull(rsTemp.getString("Category")));
                lstTemp.add(listNode);
            }
            helper.positioning(lstTemp.size(), blnToEndOfFile);
            rstTemp.setPaging(helper.getPaging());
            rstTemp.setStatus(true);
            rsTemp.close();
            psTemp.close();
            cnTemp.close();
        } catch (Exception e) {
            rstTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }

                if (psTemp != null) {
                    psTemp.close();
                }

                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return rstTemp;
    }

    @Override
    public DmResultPageing<List<TxtHAccountName_Mdl>> getTxtHAccountName(DmHelper helper, boolean blnToEndOfFile, String v_Type) {
        DmResultPageing<List<TxtHAccountName_Mdl>> rstTemp = new DmResultPageing<>();
        List<TxtHAccountName_Mdl> lstTemp = new ArrayList<>();
        TxtHAccountName_Mdl listNode;
        Connection cnTemp = null;
        ResultSet rsTemp = null;
        DmPreparedStatement psTemp = null;
        String sqlQuery;
        DmSQLWithParam sqlWithParam = new DmSQLWithParam();

        try {
            rstTemp.setData(lstTemp);
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            sqlQuery = "SELECT"
                    + "   sg.subCode AS code"
                    + " , sg.name"
                    + " , c.cityName"
                    + " , sg.manualCode"
                    + " , sgn.name AS nature"
                    + " , sgn.manualCode AS natureManualCode"
                    + " , sg.tds_Catg AS tdsCode"
                    + " , tc.Name AS tdsName"
                    + "	FROM subGroup sg"
                    + "	LEFT JOIN city c ON c.cityCode = sg.cityCode"
                    + "	LEFT JOIN subGroupSiteList sgl ON sg.subCode = sgl.subCode"
                    + "	LEFT JOIN subGroupNature sgn ON sg.nature = sgn.code"
                    + " LEFT JOIN tdsCat tc ON sg.tds_Catg = tc.code "
                    + "	WHERE sgl.site_Code = :site_Code"
                    + " AND sgn.code IN (SELECT nature FROM acFilteration WHERE v_Type = :v_Type)"
                    + "	AND sg.isActive = 1";
            sqlWithParam.setSQL(sqlQuery);
            psTemp = DmServer.evaluateHelper(helper, sqlWithParam, cnTemp, blnToEndOfFile, this);
            psTemp.setString("v_Type", DmShared.iNull(v_Type).toString());
            psTemp.setString("site_Code", DmServer.getSsnSiteCode(this));
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                listNode = new TxtHAccountName_Mdl();
                listNode.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("code")));
                listNode.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("name")));
                listNode.setManualCode(DmShared.xNull(rsTemp.getString("manualCode")));
                listNode.setCityName(DmShared.xNull(rsTemp.getString("cityName")));
                listNode.setNature(DmShared.xNull(rsTemp.getString("nature")));
                listNode.setNatureManualCode(DmShared.xNull(rsTemp.getString("natureManualCode")));
                listNode.setTdsCatCode(DmShared.xNull(rsTemp.getString("tdsCode")));
                listNode.setTdsCatName(DmShared.xNull(rsTemp.getString("tdsName")));
                lstTemp.add(listNode);
            }
            helper.positioning(lstTemp.size(), blnToEndOfFile);
            rstTemp.setPaging(helper.getPaging());

            rsTemp.close();
            psTemp.close();

            rstTemp.setStatus(true);
            cnTemp.close();
        } catch (Exception e) {
            rstTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return rstTemp;
    }

    @Override
    public DmResult<DefaultValue_Mdl> getDefaultValues() {
        DmResult<DefaultValue_Mdl> dmrTemp = new DmResult();
        DefaultValue_Mdl defaultValue = new DefaultValue_Mdl();
        Connection cnTemp = null;
        ResultSet rsTemp = null;
        DmPreparedStatement psTemp = null;
        String sqlQuery;

        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            sqlQuery = "SELECT  vt.v_Type, vt.description, vt.guiTemplateCode "
                    + "         FROM voucher_Type vt "
                    + "         WHERE vt.short_Name = " + vCat1 + " AND vt.isActive = 1 ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            rsTemp = psTemp.executeQuery();
            if (rsTemp.next()) {
                defaultValue.setVoucherTypeCode(DmShared.iNull(rsTemp.getString("v_Type")).toString());
                defaultValue.setVoucherTypeName(DmShared.xNull(rsTemp.getString("description")));

            }
            rsTemp.close();
            psTemp.close();

            dmrTemp.setData(defaultValue);
            cnTemp.close();
            dmrTemp.setStatus(true);
        } catch (Exception e) {
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public DmResultPageing<List<TxtHSupplier_Mdl>> getTxtHSupplier(DmHelper helper, boolean blnToEndOfFile) {
        DmResultPageing<List<TxtHSupplier_Mdl>> rstTemp = new DmResultPageing<>();
        Connection cnTemp = null;
        ResultSet rsTemp = null;
        DmPreparedStatement psTemp = null;
        DmSQLWithParam sqlWithParam = new DmSQLWithParam();
        List<TxtHSupplier_Mdl> listNode = new ArrayList<>();
        TxtHSupplier_Mdl node;
        String sqlQuery;
        rstTemp.setData(listNode);

        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            sqlQuery = " select sg.name AS name,sg.subCode AS code,\n"
                    + " sg.manualCode as manualCode , ct.cityName as cityName\n"
                    + " from subGroup sg \n"
                    + " left join subGroupNature sgn on sgn.code = sg.nature \n"
                    + " left join city ct on ct.cityCode = sg.cityCode \n"
                    + " WHERE sgn.manualCode = 'CT' ";

            sqlWithParam.setSQL(sqlQuery);
            psTemp = DmServer.evaluateHelper(helper, sqlWithParam, cnTemp, blnToEndOfFile, this);
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                node = new TxtHSupplier_Mdl();
                node.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("code")));
                node.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("name")));
                node.setManualCode(DmShared.xNull(rsTemp.getString("manualCode")));
                node.setCityName(DmShared.xNull(rsTemp.getString("cityName")));
                listNode.add(node);
            }
            rsTemp.close();
            psTemp.close();
            cnTemp.close();

            helper.positioning(listNode.size(), blnToEndOfFile);
            rstTemp.setPaging(helper.getPaging());
            rstTemp.setStatus(true);
        } catch (Exception e) {
            rstTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return rstTemp;
    }

    @Override
    public DmResult<List<GrdPendingFPReqDetail_Mdl>> getPendingFinalPaymnetReqDetail(String supplierCode) {
        DmResult<List<GrdPendingFPReqDetail_Mdl>> dmrTemp = new DmResult();
        Connection cnTemp = null;
        DmPreparedStatement psTemp = null;
        ResultSet rsTemp = null;
        List<GrdPendingFPReqDetail_Mdl> lstNode = new ArrayList<>();
        String sqlQuery = "";
        dmrTemp.setData(lstNode);
        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));
            /*====================================< Get Grid Detail  >====================================*/

            sqlQuery = "Select lg.docid as sbDocId ,lg.recID as sbRecId, \n"
                    + "   lg.v_Date  as voucherDate,vt.short_Name as voucherType ,vt.description , \n"
                    + "   lg.refNo as partyBillNo, lg.refDate as partyBillDate,sg.name as debtorName,\n"
                    + "   lg.subcode as debtorCode,lg.amtDr as billAmount,isNull(v1.adjustment,0) adjustmentAmt,"
                    + "   lg.amtdr - case when isnull(v1.adjustment,0) < 0 then -(isnull(v1.adjustment,0)) else isnull(v1.adjustment,0) end as pendingToAdjust  \n"
                    + "   ,lg.v_SNo as lgV_SNo \n"
                    + "   FROM ledger lg \n"
                    + "   left JOIN voucher_Type vt On vt.v_Type=lg.v_type \n"
                    + "   LEFT JOIN subGroup AS sg ON lg.subcode = sg.subCode\n"
                    + "   left join (\n"
                    + "   select adj.adj_DocId as docid,sum(adj.adjustment) as adjustment, max(adj.adj_V_SNo) V_SNo\n"
                    + "		from ledgerAdj as adj\n"
                    + "		group by adj.adj_DocId\n"
                    + "   ) as v1 on v1.docId = lg.docId  and v1.V_SNo = lg.v_sno\n"
                    + "    where lg.subcode = :supplierCode\n"
                    + "	 and lg.isPosted=1\n"
                    + "	 and lg.site_Code = :site_Code\n"
                    + "	 and lg.v_Prefix= " + DmServer.getSsnVoucherPrefix(this) + " \n"
                    + "	 and lg.amtDr-case when isnull(v1.adjustment,0) < 0 then -(isnull(v1.adjustment,0)) else isnull(v1.adjustment,0) end >0\n"
                    + "	 and vt.description not in ('Whole Sale Bill Return')\n"
                    + "  and vt.category not in (" + vCat + ")"
                    + "  order by lg.docId";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setLong("supplierCode", DmShared.iNull(supplierCode).longValue());
            psTemp.setString("site_Code", DmServer.getSsnSiteCode(this));
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                GrdPendingFPReqDetail_Mdl node = new GrdPendingFPReqDetail_Mdl();
                node.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("sbDocId")));
                node.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("sbRecId")));
                node.setLgV_SNo(DmShared.xNull(rsTemp.getString("lgV_SNo")));
                node.setVoucherDate(DmShared.dNull(rsTemp.getDate("voucherDate")));
                node.setVoucherType(DmShared.xNull(rsTemp.getString("voucherType")));
                node.setPartyBillNo(DmShared.xNull(rsTemp.getString("partyBillNo")));
                node.setPartyBillDate(DmShared.dNull(rsTemp.getDate("partyBillDate")));
                node.setDebtorName(DmShared.xNull(rsTemp.getString("debtorName")));
                node.setDebtorCode(DmShared.xNull(rsTemp.getString("debtorCode")));
                node.setBillAmountAmt(DmShared.xNull(rsTemp.getString("pendingToAdjust")));

                lstNode.add(node);
            }
            rsTemp.close();
            psTemp.close();
            cnTemp.close();
            dmrTemp.setStatus(true);

        } catch (Exception e) {
            e.printStackTrace();
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public DmResult<List<GridDrAdjustBills_Mdl>> getPendingFinalCreditAdjmentRec(String supplierCode) {
        DmResult<List<GridDrAdjustBills_Mdl>> dmrTemp = new DmResult();
        Connection cnTemp = null;
        DmPreparedStatement psTemp = null;
        ResultSet rsTemp = null;
        List<GridDrAdjustBills_Mdl> lstNode = new ArrayList<>();
        String sqlQuery = "";
        dmrTemp.setData(lstNode);
        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            sqlQuery = "SELECT  lg.docId as billDocId,lg.recId AS billRecId ,lg.v_date as voucherDate,lg.v_SNo,sg.name as supplierName,sg.subcode as supplierCode\n"
                    + "         ,sgc.name as contraAc,\n"
                    + "		vt.short_Name as voucherType ,lg.refNo,\n"
                    + "		lg.amtCr,\n"
                    + "		--isnull(adj.adjustment,0) as adjAmt,\n"
                    + "		case when isnull(adj.adjustment,0) < 0 then -(isnull(adj.adjustment,0)) else isnull(adj.adjustment,0) end as  adjAmt,\n"
                    + "		lg.amtCr- case when isnull(adj.adjustment,0) < 0 then -(isnull(adj.adjustment,0)) else isnull(adj.adjustment,0) end as pendingAdjustment\n"
                    + "\n"
                    + "		FROM LEDGER LG\n"
                    + "		left join subgroup sg on sg.subcode=lg.subcode\n"
                    + "		left join subGroupNature sgn on sgn.code=sg.nature\n"
                    + "		left join subgroup sgc on sgc.subcode=lg.contraSub\n"
                    + "		left join voucher_Type vt on vt.v_Type=lg.v_Type\n"
                    + "		left join customEnviro ce on ce.site_Code=lg.site_Code\n"
                    + " \n"
                    + "		left join (\n"
                    + "		select adj.vr_DocId as docid,sum(adj.adjustment) as adjustment\n"
                    + "		from ledgerAdj as adj\n"
                    + "		group by adj.vr_DocId\n"
                    + "		) as adj on adj.docid=lg.docid\n"
                    + "		WHERE isnull(lg.amtcr,0)<>0 and lg.site_Code=1\n"
                    + "		and lg.isPosted=1\n"
//                    + "		and lg.v_Prefix=25   \n"
                    //                    + "		and vt.description not in ('Bank Receipt','Cash Receipt')\n"
                    + "		and lg.amtcr-case when isnull(adj.adjustment,0) < 0 then -(isnull(adj.adjustment,0)) else isnull(adj.adjustment,0) end <>0\n"
                    + "		and lg.subcode= :supplierCode \n"
                    + "		order by lg.docId,vt.short_Name";

            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setLong("supplierCode", DmShared.iNull(supplierCode).longValue());
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                GridDrAdjustBills_Mdl node = new GridDrAdjustBills_Mdl();
                node.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("billDocId")));
                node.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("billRecId")));
                node.setVoucherDate(DmShared.dNull(rsTemp.getDate("voucherDate")));
                node.setVr_V_SNo(DmShared.xNull(rsTemp.getString("v_SNo")));
                node.setSupplierTag(DmShared.xNull(rsTemp.getString("supplierCode")));
                node.setRefNo(DmShared.xNull(rsTemp.getString("refNo")));
                node.setSupplierText(DmShared.xNull(rsTemp.getString("supplierName")));
                node.setContraAC(DmShared.xNull(rsTemp.getString("contraAc")));
                node.setVoucherType(DmShared.xNull(rsTemp.getString("voucherType")));
                node.setAmtcr(DmShared.xNull(rsTemp.getString("amtCr")));
                node.setAdjAmt(DmShared.xNull(rsTemp.getString("adjAmt")));
                node.setPendingAdjustment(DmShared.xNull(rsTemp.getString("pendingAdjustment")));

                lstNode.add(node);
            }
            rsTemp.close();
            psTemp.close();

            cnTemp.close();
            dmrTemp.setStatus(true);

        } catch (Exception e) {
            e.printStackTrace();
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public String[] getServerDateTime() {
        String[] dateTime, returnValue;

        dateTime = DmServer.getServerDateTime();
        returnValue = new String[3];
        returnValue[0] = dateTime[0];
        returnValue[1] = dateTime[1];
        returnValue[2] = UUID.randomUUID().toString();

        return returnValue;
    }

    @Override
    public DmResult<String> saveRecord(WholesaleBillSettlement_Mdl mrTemp, boolean isApprove) {
        DmResult<String> dmrTemp = new DmResult();
        Connection cnTemp = null;
        DmPreparedStatement psTemp = null;
        ResultSet rsTemp = null;
        DmSavePoint spBegin = null;
        String sqlQuery, vNo = "", voucherPrefix;
        boolean blnAdd = false;
        int vSNo = 0;
        try {
            WholesaleBillSettlement_Vld.chkSave(mrTemp);
            voucherPrefix = DmServer.getSsnVoucherPrefix(this);
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));
            spBegin = new DmSavePoint(cnTemp);

            if (DmShared.xNull(mrTemp.getSharedKeyFieldCode()).equalsIgnoreCase("")) {
                blnAdd = true;
                mrTemp.setSharedKeyFieldCode(DmServer.getDocId(DmShared.xNull(mrTemp.getVoucherTypeTag()), voucherPrefix, cnTemp, this));
                mrTemp.setRecId(DmServer.getRecId("ledgerM", "docId", DmShared.xNull(mrTemp.getSharedKeyFieldCode()), "recId", mrTemp.getRecId(), mrTemp.getV_Date(), DmShared.xNull(mrTemp.getVoucherTypeTag()), voucherPrefix, cnTemp, this, true));
                mrTemp.setSharedKeyFieldName(DmShared.xNull(mrTemp.getRecId().getRecIdValue()));
            }

            if (blnAdd) {

                sqlQuery = "Insert Into LedgerM (DocId,V_Type,V_Prefix,Site_Code, V_No, V_Date,SubCode,"
                        + " Narration,RecId, recIdPrefix, U_EntDt,PreparedBy,remark) "
                        + "Values (:DocId,:V_Type,:V_Prefix,:Site_Code, :V_No, :V_Date,:SubCode,:Narration,:RecId,"
                        + " :recIdPrefix, :uEntDt,"
                        + " :preparedBy,:remark)";
                psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                psTemp.setString("DocId", mrTemp.getSharedKeyFieldCode());
                psTemp.setString("RecId", mrTemp.getSharedKeyFieldName());
                psTemp.setString("V_Type", mrTemp.getVoucherTypeTag());
                psTemp.setString("V_Prefix", DmServer.getSsnVoucherPrefix(this));
                psTemp.setString("Site_Code", DmServer.getSsnSiteCode(this));
                psTemp.setString("recIdPrefix", DmShared.xNull(mrTemp.getRecId().getPrefix()));
                psTemp.setString("V_No", mrTemp.getRecId().getCounter().toString());
                psTemp.setDate("V_Date", DmServer.convertDate(mrTemp.getV_Date()));
                psTemp.setString("SubCode", DmShared.foriegnKey(mrTemp.getSupplierTag()));
                psTemp.setString("Narration", "");
                psTemp.setString("preparedBy", DmServer.getSsnUserName(this));
                psTemp.setTimestamp("uEntDt", DmServer.getServerTimestamp());
                psTemp.setString("remark", DmShared.xNull(mrTemp.getRemark()));
            } else {

                sqlQuery = "update LedgerM Set "
                        + "V_Date=:V_Date,"
                        + "SubCode=:SubCode,"
                        + "Narration=:Narration,"
                        + "transferDt=:transferDt,"
                        + "U_Name=:uName,"
                        + "remark=:remark, "
                        + "U_EntDt=:uEntDt "
                        + "Where DocId=:DocId ";
                psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                psTemp.setDate("V_Date", DmServer.convertDate(mrTemp.getV_Date()));
                psTemp.setString("SubCode", DmShared.foriegnKey(mrTemp.getAccountNameCode()));
                psTemp.setString("Narration", "");
                psTemp.setString("transferDt", null);
                psTemp.setString("uName", DmServer.getSsnUserName(this));
                psTemp.setTimestamp("uEntDt", DmServer.getServerTimestamp());
                psTemp.setString("DocId", mrTemp.getSharedKeyFieldCode());
                psTemp.setString("remark", DmShared.xNull(mrTemp.getRemark()));
            }
            psTemp.executeUpdate();
            psTemp.close();

//            for (int i = 0; i < 2; i++) {
//                if (!DmShared.xNull(mrTemp.getSharedKeyFieldCode()).equalsIgnoreCase("")) {
//                    vSNo++;
//
//                    sqlQuery = "Insert Into Ledger (DocId, RecId, recIdPrefix, V_No, V_SNo,V_Date,SubCode,ContraSub,AmtDr,AmtCr,"
//                            + "V_Type,V_Prefix,Site_Code,"
