//                            + ":V_Type,:V_Prefix,:Site_Code,"
//                            + ":u_Name,:u_EntDt)";
//                    psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
//                    psTemp.setString("DocId", mrTemp.getSharedKeyFieldCode());
//                    psTemp.setString("RecId", mrTemp.getSharedKeyFieldName());
//                    psTemp.setString("recIdPrefix", DmShared.xNull(mrTemp.getRecId().getPrefix()));
//                    psTemp.setString("V_No", mrTemp.getRecId().getCounter().toString());
//                    psTemp.setString("V_SNo", DmServer.vNull(vSNo, "0"));
//                    psTemp.setDate("V_Date", DmServer.convertDate(mrTemp.getV_Date()));
//                    if (i == 0) {
//                        psTemp.setString("SubCode", DmShared.foriegnKey(mrTemp.getAccountNameCode()));
//                        psTemp.setString("ContraSub", DmShared.foriegnKey(mrTemp.getSupplierTag()));
//                        psTemp.setString("AmtDr", "0.00");
//                        psTemp.setString("AmtCr", DmServer.vNull(mrTemp.getCreditAmt(), "0.00"));
//                    } else {
//                        psTemp.setString("SubCode", DmShared.foriegnKey(mrTemp.getSupplierTag()));
//                        psTemp.setString("ContraSub", DmShared.foriegnKey(mrTemp.getAccountNameCode()));
//                        psTemp.setString("AmtDr", DmServer.vNull(mrTemp.getCreditAmt(), "0.00"));
//                        psTemp.setString("AmtCr", "0.00");
//                    }
//                    psTemp.setString("V_Type", mrTemp.getVoucherTypeTag());
//                    psTemp.setString("V_Prefix", voucherPrefix);
//                    psTemp.setString("Site_Code", DmServer.getSsnSiteCode(this));
//
//                    psTemp.setString("u_Name", DmServer.getSsnUserName(this));
//                    psTemp.setTimestamp("u_EntDt", DmServer.getServerTimestamp());
//                    psTemp.executeUpdate();
//                    psTemp.close();
//                }
//            }
            /*==============================<< Delete record from ladgerAdj >>===============================*/
            if (blnAdd) {
                sqlQuery = " Delete From ledgerAdj Where finPayDocId= :docId ";
                psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                psTemp.setString("docId", DmShared.iNull(mrTemp.getSharedKeyFieldCode()).toString());
                psTemp.executeUpdate();
                psTemp.close();

                for (Map.Entry<String, List<HashMap<String, LedgerAdj_Mdl>>> entry : mrTemp.getListHmMain().entrySet()) {
                    String vr_DocId = entry.getKey();
                    List<HashMap<String, LedgerAdj_Mdl>> listOfMaps = entry.getValue();
                    for (HashMap<String, LedgerAdj_Mdl> innerMap : listOfMaps) {
                        for (Map.Entry<String, LedgerAdj_Mdl> innerEntry : innerMap.entrySet()) {
                            String adj_DocId = innerEntry.getKey();
                            LedgerAdj_Mdl ledgerMdlValue = innerEntry.getValue();
                            if (DmShared.vNull(ledgerMdlValue.getAdjustment()) != 0) {
                                sqlQuery = "INSERT INTO ledgerAdj (vr_DocId, vr_V_SNo, vr_SubCode, vr_V_Date, adj_DocId, adj_V_SNo, adj_SubCode, adj_V_Date, adjustment,finPayDocId)"
                                        + " VALUES (:vr_DocId, :vr_V_SNo, :vr_SubCode, :vr_V_Date, :adj_DocId, :adj_V_SNo, :adj_SubCode, :adj_V_Date, :adjustment,:finPayDocId)";
                                psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                                psTemp.setString("vr_DocId", DmShared.foriegnKey(vr_DocId));
                                psTemp.setString("vr_V_SNo", DmShared.foriegnKey(ledgerMdlValue.getVr_V_SNo()));
                                psTemp.setString("vr_SubCode", DmShared.foriegnKey(mrTemp.getSupplierTag()));
                                psTemp.setDate("vr_V_Date", DmServer.convertDate(mrTemp.getV_Date()));
                                psTemp.setString("adj_DocId", DmShared.foriegnKey(adj_DocId));
                                psTemp.setString("adj_V_SNo", DmShared.foriegnKey(DmShared.xNull(ledgerMdlValue.getAdj_V_SNo())));
                                psTemp.setString("adj_SubCode", DmShared.foriegnKey(mrTemp.getSupplierTag()));
                                psTemp.setDate("adj_V_Date", DmServer.convertDate(mrTemp.getV_Date()));
                                double adjustment = DmShared.vNull(ledgerMdlValue.getAdjustment());
                                psTemp.setString("adjustment", DmServer.vNull(-adjustment));
                                psTemp.setString("finPayDocId", mrTemp.getSharedKeyFieldCode());
                                psTemp.executeUpdate();
                                psTemp.close();
                            }
                        }
                    }
                }
            }

            dmrTemp.setData(mrTemp.getSharedKeyFieldCode());
            spBegin.commit();
            cnTemp.close();
            dmrTemp.setStatus(true);

        } catch (Exception e) {
            try {
                if (spBegin != null) {
                    spBegin.rollBack();
                }
            } catch (Exception ex) {
            }
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public DmResult<WholesaleBillSettlement_Mdl> getMoveRec(String strKey) {
        DmResult<WholesaleBillSettlement_Mdl> dmrTemp = new DmResult();
        Connection cnTemp = null;
        DmPreparedStatement psTemp = null;
        ResultSet rsTemp = null;
        String sqlQuery;
        WholesaleBillSettlement_Mdl mrTemp = new WholesaleBillSettlement_Mdl();
        GrdPendingFPReqDetail_Mdl drNode;
        GridDrAdjustBills_Mdl crNode;
        dmrTemp.setData(mrTemp);

        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            /*====================================< Get LedgerM Detail >====================================*/
            sqlQuery = "select lam.docId , lam.recId , lam.v_Date , lam.subcode as supplierCode,sg.name as supllieName,\n"
                    + "vt.description, vt.v_type,lam.PreparedBy,lam.approvedBy\n"
                    + "from ledgerM lam\n"
                    + "left join voucher_Type vt on vt.v_Type = lam.v_Type\n"
                    + "left join subGroup sg on sg.subCode  =  lam.subcode\n"
                    + "where lam.docId = :docid  ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setLong("docid", DmShared.iNull(strKey).longValue());
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                mrTemp.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("docId")));
                mrTemp.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("recId")));
                mrTemp.setV_Date(DmShared.dNull(rsTemp.getDate("v_Date")));
                mrTemp.setSupplierText(DmShared.xNull(rsTemp.getString("supllieName")));
                mrTemp.setSupplierTag(DmShared.xNull(rsTemp.getString("supplierCode")));
                mrTemp.setVoucherTypeText(DmShared.xNull(rsTemp.getString("description")));
                mrTemp.setVoucherTypeTag(DmShared.xNull(rsTemp.getString("v_type")));
                mrTemp.setSharedPreparedBy(DmShared.xNull(rsTemp.getString("PreparedBy")));
                mrTemp.setApprovedBy(DmShared.xNull(rsTemp.getString("approvedBy")));

            }
            psTemp.close();
            rsTemp.close();

            /*====================================< Get SaleBills Detail >====================================*/
            sqlQuery = " select\n"
                    + "la.adj_docId as sbdocId,max(la.adj_V_SNo) as lgV_SNo,max(lg.recId) as sbrecId, max(lg.v_Date) as voucherDate,\n"
                    + "max(vt.short_Name) as shortName,max(lg.refNo) as partyBillNo,\n"
                    + "abs(sum(la.adjustment)) as billAmount\n"
                    + "from ledgeradj la\n"
                    + "left join ledger lg on lg.docId  = la.adj_DocId and lg.v_SNo = la.adj_V_SNo \n"
                    + "left join voucher_Type vt on vt.v_type = lg.v_Type\n"
                    + "where ISNULL(vt.category, '') <> 'WSBSM' \n"
                    + "and la.finPayDocId = :docid \n"
                    + "group by la.adj_docId ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setLong("docid", DmShared.iNull(strKey).longValue());
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                drNode = new GrdPendingFPReqDetail_Mdl();
                drNode.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("sbdocId")));
                drNode.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("sbrecId")));
                drNode.setVoucherDate(DmShared.dNull(rsTemp.getDate("voucherDate")));
                drNode.setLgV_SNo(DmShared.xNull(rsTemp.getString("lgV_SNo")));
                drNode.setVoucherType(DmShared.xNull(rsTemp.getString("shortName")));
                drNode.setPartyBillNo(DmShared.xNull(rsTemp.getString("partyBillNo")));
//                drNode.setDebtorName(DmShared.xNull(rsTemp.getString("debtorName")));
//                drNode.setDebtorCode(DmShared.xNull(rsTemp.getString("debtorCode")));
                drNode.setBillAmountAmt(DmServer.vNull(rsTemp.getString("billAmount"), "0.00"));
//                drNode.setAdjustedAmt(DmServer.vNull(rsTemp.getString("adjustmentAmt"), "0.00"));
                drNode.setChecked("1");
                mrTemp.getLstPendingFPayReq().add(drNode);

            }
            psTemp.close();
            rsTemp.close();

            /*====================================< Get saleBills Return Detail >====================================*/
            sqlQuery = "select la.vr_DocId,la.vr_V_SNo,la.vr_SubCode,la.vr_V_Date,la.adj_DocId\n"
                    + "   ,la.adj_SubCode,la.adj_V_Date,la.adj_V_SNo\n"
                    + "  ,abs(la.adjustment) AS adjustmentAmount\n"
                    + " ,lg.recId As billRecId\n"
                    + " ,vt.short_Name AS voucherType\n"
                    + " from ledgeradj la\n"
                    + "left join ledger lg on lg.docId  = la.vr_DocId and lg.v_SNo = la.vr_V_SNo \n"
                    + "left join voucher_Type vt on vt.v_type = lg.v_Type\n"
                    + "where ISNULL(vt.category, '') <> 'WSBSM' "
                    + "and la.finPayDocId = :docid";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setLong("docid", DmShared.iNull(strKey).longValue());
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                crNode = new GridDrAdjustBills_Mdl();
                crNode.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("vr_DocId")));
                crNode.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("billRecId")));
                crNode.setVr_V_SNo(DmShared.xNull(rsTemp.getString("vr_V_SNo")));
                crNode.setAdj_V_SNo(DmShared.xNull(rsTemp.getString("adj_V_SNo")));
                crNode.setSupplierTag(DmShared.xNull(rsTemp.getString("vr_SubCode")));
                crNode.setVoucherDate(DmShared.dNull(rsTemp.getDate("vr_V_Date")));
//                crNode.setSharedPreparedBy(DmShared.xNull(rsTemp.getString("adj_DocId")));
                crNode.setVoucherType(DmShared.xNull(rsTemp.getString("voucherType")));
                crNode.setPendingAdjustment(DmServer.vNull(rsTemp.getString("adjustmentAmount"), "0.00"));
                crNode.setChecked("1");

                mrTemp.getLstdrAdjustAmt().add(crNode);
            }
            psTemp.close();
            rsTemp.close();

            cnTemp.close();
            dmrTemp.setData(mrTemp);
            dmrTemp.setStatus(true);
        } catch (SQLException | DmException e) {
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public DmResult<List<KeyFieldExtended>> getNavigator(UserPermission userPermission) {
        DmResult<List<KeyFieldExtended>> dmrTemp = new DmResult();
        DmPreparedStatement psTemp = null;
        Connection cnTemp = null;
        ResultSet rsTemp = null;
        List<KeyFieldExtended> lstNavigator = new ArrayList<>();
        KeyFieldExtended lstNavigatorTmp;
        dmrTemp.setData(lstNavigator);

        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            psTemp = DmPreparedStatement.prepareStatement(cnTemp, "select lgm.docId "
                    + "                        from ledgerM lgm "
                    + "                   	left join voucher_Type as vt on lgm.v_Type = vt.v_Type "
                    + "                         where lgm.site_code=:site_code and vt.category = " + vCat1 + ""
                    + "                   	Order by  lgm.v_Date,  lgm.v_No, lgm.recId ");
            psTemp.setString("site_Code", DmShared.iNull(DmServer.getSsnSiteCode(this)).toString());
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                lstNavigatorTmp = new KeyFieldExtended();
                lstNavigatorTmp.setSharedKeyFieldCode(DmShared.xNull(rsTemp.getString("docId")));
                lstNavigator.add(lstNavigatorTmp);
            }
            dmrTemp.setStatus(true);
            rsTemp.close();
            psTemp.close();
            cnTemp.close();
        } catch (Exception e) {
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public DmResultPageing<List<Find_Mdl>> getFind(UserPermission userPermission, DmHelper helper, boolean blnToEndOfFile) {
        DmResultPageing<List<Find_Mdl>> rstTemp = new DmResultPageing<>();
        List<Find_Mdl> lstTemp = new ArrayList<>();
        Find_Mdl listNode;
        Connection cnTemp = null;
        ResultSet rsTemp = null;
        DmPreparedStatement psTemp = null;
        DmSQLWithParam sqlWithParam = new DmSQLWithParam();
        String sqlQuery;
        rstTemp.setData(lstTemp);
        try {

            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            sqlQuery = " Select lgm.docid ,max(lgm.recid) as recid ,max(lgm.v_No) as v_No , max(lgm.v_date) as date ,\n"
                    + "  max(sg.name) as supplierName,\n"
                    + "  max(lgm.remark) as remark , sum(abs(v1.adjustmentAmt)) as finalAmt, \n"
                    + "  max(sg.subcode) as subcode, max(sg.name) as acName,  \n"
                    + "  max(sg.nature) as acNature,MAX(lgm.approvedBy) as approvedBy\n"
                    + "  from ledgerM lgm  \n"
                    + "    LEFT JOIN voucher_Type AS vt ON lgm.v_Type = vt.v_Type \n"
                    + "	left join subGroup sg On lgm.subcode = sg.subCode \n"
                    + "	left join (\n"
                    + "   select la.finPayDocId , la.adjustment as adjustmentAmt\n"
                    + "   from ledgerAdj la\n"
                    + "   ) as v1 on v1.finPayDocId = lgm.docId \n"
                    + "	  WHERE vt.category in (" + vCat1 + ")  \n"
                    + "	  AND lgm.site_Code = :site_Code \n"
                    + "	  AND lgm.v_prefix = :vPrefix \n"
                    + "	  group by lgm.docid \n";

            sqlWithParam.setSQL(sqlQuery);
            sqlWithParam.setString("site_Code", DmServer.getSsnSiteCode(this));
            sqlWithParam.setString("vPrefix", DmServer.getSsnVoucherPrefix(this));
            psTemp = DmServer.evaluateHelper(helper, sqlWithParam, cnTemp, blnToEndOfFile, this);
            rsTemp = psTemp.executeQuery();
            while (rsTemp.next()) {
                listNode = new Find_Mdl();
                listNode.setSharedKeyFieldCode(DmShared.iNull(rsTemp.getString("docId")).toString());
                listNode.setSharedKeyFieldName(DmShared.xNull(rsTemp.getString("recid")));
                listNode.setSupplier(DmShared.xNull(rsTemp.getString("supplierName")));
                listNode.setRemark(DmShared.xNull(rsTemp.getString("remark")));
                listNode.setPayDate(DmShared.xNull(rsTemp.getString("date")));
                listNode.setOrgAmt(DmServer.vNull(rsTemp.getString("finalAmt"), "0.00"));
                listNode.setApprovedBy(DmShared.xNull(rsTemp.getString("approvedBy")));
                lstTemp.add(listNode);
            }
            helper.positioning(lstTemp.size(), blnToEndOfFile);
            rstTemp.setPaging(helper.getPaging());
            rstTemp.setStatus(true);
            rsTemp.close();
            psTemp.close();
            cnTemp.close();
        } catch (Exception e) {
            rstTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }

                if (psTemp != null) {
                    psTemp.close();
                }

                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return rstTemp;
    }

    @Override
    public DmResult<String> deleteRecord(String strKey) {
        DmResult<String> dmrTemp = new DmResult();
        Connection cnTemp = null;
        DmPreparedStatement psTemp = null;
        DmSavePoint spBegin = null;
        String sqlQuery;
        ResultSet rsTemp = null;
        dmrTemp.setData(strKey);

        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));
            spBegin = new DmSavePoint(cnTemp);
            sqlQuery = "select approvedBy  FROM ledgerM WHERE  docId = :docId ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setString("docId", DmShared.iNull(strKey).toString());
            rsTemp = psTemp.executeQuery();
            if (rsTemp.next()) {

                if (!DmShared.xNull(rsTemp.getString("approvedBy")).equalsIgnoreCase("")) {
                    throw new DmException(0, "Record is approved. You can't delete this record.");
                }
            }
            rsTemp.close();
            psTemp.close();

            /*==============================<< Delete record from ledgerM >>===============================*/
            sqlQuery = " Delete From ledgerM Where docId= :docId ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setString("docId", DmShared.iNull(strKey).toString());
            psTemp.executeUpdate();
            psTemp.close();

            /*==============================<< Delete record from ledgerAdj >>===============================*/
            sqlQuery = " Delete From ledgerAdj Where finPayDocId= :docId ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
            psTemp.setString("docId", DmShared.iNull(strKey).toString());
            psTemp.executeUpdate();
            psTemp.close();

            spBegin.commit();
            cnTemp.close();
            dmrTemp.setStatus(true);
        } catch (Exception e) {
            try {
                if (spBegin != null) {
                    spBegin.rollBack();
                }
                if (e instanceof DmException) {
                    dmrTemp.setErrorNumber(((DmException) e).getErrorNo());
                    dmrTemp.setValue1(((DmException) e).getErrorSource());
                    dmrTemp.setValue2(((DmException) e).getErrorSourceCode());
                }
            } catch (Exception ex) {
                dmrTemp.setErrorMessage(DmShared.xNull(ex.getMessage()));
            }
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    @Override
    public DmResult<String> setApproval(String approvedBy, boolean isApprove, String docId) {
        DmResult<String> dmrTemp = new DmResult();
        Connection cnTemp = null;
        DmSavePoint spBegin = null;
        dmrTemp.setData("");

        try {
            cnTemp = DmServer.getConnection(DmServer.getSsnDBName(this));

            spBegin = new DmSavePoint(cnTemp);

            if (isApprove) {
                documentApproval(WalkThroughEnum.ACCEPT, docId, approvedBy, cnTemp);
            } else {
                documentApproval(WalkThroughEnum.DECLINE, docId, approvedBy, cnTemp);
            }
            dmrTemp.setData(docId);

            spBegin.commit();
            cnTemp.close();
            dmrTemp.setStatus(true);
        } catch (Exception e) {
            try {
                if (spBegin != null) {
                    spBegin.rollBack();
                }
            } catch (Exception ex) {
            }
            dmrTemp.setErrorMessage(DmShared.xNull(e.getMessage()));
        } finally {
            try {
                if (cnTemp != null && !cnTemp.isClosed()) {
                    cnTemp.close();
                }
            } catch (Exception e) {
            }
        }
        return dmrTemp;
    }

    private void documentApproval(WalkThroughEnum walkThroughMove, String keyCode, String userName, Connection cnTemp) throws Exception {
        ResultSet rsTemp = null;
        DmPreparedStatement psTemp = null;
        String sqlQuery = "";

        try {


            /*==============================<< Check if document is in use >>====================================*/
            sqlQuery = "select approvedBy,approvedDt,"
                    + "(case when :userName IN (ISNULL(approvedBy,''),'SA','SUPER') then 1 else 0 end) canApprove "
                    + "from ledgerM where docId = :docId ";
            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery, ResultSet.TYPE_SCROLL_SENSITIVE, ResultSet.CONCUR_UPDATABLE);
            psTemp.setString("docId", DmShared.iNull(keyCode).toString());
            psTemp.setString("userName", userName);
            rsTemp = psTemp.executeQuery();
            if (rsTemp.next()) {
                if (walkThroughMove == WalkThroughEnum.ACCEPT) {
                    if (DmShared.xNull(rsTemp.getString("approvedBy")).trim().equalsIgnoreCase("")) {

                        rsTemp.updateString("approvedBy", DmShared.xNull(userName).trim());
                        rsTemp.updateTimestamp("approvedDt", new Timestamp(new java.util.Date().getTime()));
                        rsTemp.updateRow();
                        rsTemp.close();
                        psTemp.close();

                        sqlQuery = " Update ledgerM set "
                                + " u_EntDt=:u_EntDt "
                                + " where docId=:docId ";
                        psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                        psTemp.setString("docId", DmShared.xNull(keyCode));
                        psTemp.setTimestamp("u_EntDt", DmServer.getServerTimestamp());
                        psTemp.executeUpdate();
                        psTemp.close();

                        sqlQuery = " Update ledgerM set "
                                + " approvedBy=:approvedBy, "
                                + " approvedDt=:approvedDt  "
                                + " where docId=:docId ";
                        psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                        psTemp.setString("docId", DmShared.xNull(keyCode));
                        psTemp.setString("approvedBy", DmShared.xNull(userName).trim());
                        psTemp.setTimestamp("approvedDt", DmServer.getServerTimestamp());
                        psTemp.executeUpdate();
                        psTemp.close();

                        sqlQuery = "Update Ledger Set "
                                + "isPosted = 1 "
                                + "Where DocId = :DocId ";
                        psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                        psTemp.setString("DocId", keyCode);
                        psTemp.executeUpdate();
                        psTemp.close();

                    } else {
                        throw new Exception("Document already approved.");
                    }
                } else {
                    if (!DmShared.xNull(rsTemp.getString("approvedBy")).trim().equalsIgnoreCase("")) {
                        if (DmShared.iNull(rsTemp.getString("canApprove")).longValue() == 1) {

                            rsTemp.updateString("approvedBy", null);
                            rsTemp.updateDate("approvedDt", null);
                            rsTemp.updateRow();
                            rsTemp.close();
                            psTemp.close();

                            sqlQuery = " Update ledgerM set "
                                    + " u_EntDt=:u_EntDt "
                                    + " where docId=:docId ";
                            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                            psTemp.setString("docId", DmShared.iNull(keyCode).toString());
                            psTemp.setTimestamp("u_EntDt", DmServer.getServerTimestamp());
                            psTemp.executeUpdate();
                            psTemp.close();

                            sqlQuery = " Update ledgerM set "
                                    + " approvedBy=:approvedBy, "
                                    + " approvedDt=:approvedDt  "
                                    + " where docId=:docId ";
                            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                            psTemp.setString("docId", DmShared.xNull(keyCode));
                            psTemp.setString("approvedBy", null);
                            psTemp.setTimestamp("approvedDt", null);
                            psTemp.executeUpdate();
                            psTemp.close();

                            sqlQuery = "Update Ledger Set "
                                    + "isPosted = 0 "
                                    + "Where DocId = :DocId ";
                            psTemp = DmPreparedStatement.prepareStatement(cnTemp, sqlQuery);
                            psTemp.setString("DocId", keyCode);
                            psTemp.executeUpdate();
                            psTemp.close();

                        } else {
                            throw new Exception("Unauthorized user to unapprove.");
                        }

                    } else {
                        throw new Exception("Document already unapproved.");
                    }
                }
            }
            rsTemp.close();
            psTemp.close();
        } catch (Exception e) {
            throw new Exception(e.getMessage());
        } finally {
            try {
                if (rsTemp != null) {
                    rsTemp.close();
                }
                if (psTemp != null) {
                    psTemp.close();
                }
            } catch (Exception e) {
            }
        }
    }
}
